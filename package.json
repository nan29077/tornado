{
  "name": "tornado-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3025",
    "build": "next build",
    "start": "next start -p 3025",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "mo:reissue": "tsx scripts/reissue-legacy-mo.ts",
    "db:reset": "node tools/db-reset.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node tools/test.mjs",
    "test:watch": "node tools/test.mjs --watch",
    "test:e2e": "node e2e/run-all.mjs",
    "check:db": "node tools/check-db.mjs",
    "check:emma": "node tools/emma-check.mjs",
    "preview": "node tools/preview.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1115.0",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.1.2",
    "dayjs": "^1.11.23",
    "ioredis": "^6.0.0",
    "jose": "^6.2.9",
    "lucide-react": "^1.32.0",
    "next": "16.3.1",
    "pg": "^8.23.0",
    "prisma": "^7.9.1",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "ulid": "^3.0.2",
    "zod": "^4.4.3"
