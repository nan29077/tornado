@@ -0,0 +1,139 @@
+import type { Metadata } from 'next';
+import Link from 'next/link';
+import { notFound } from 'next/navigation';
+import { ExternalLink, HeartHandshake, Info, Sparkles, UserPlus } from 'lucide-react';
+import { VideoHubShell } from '@/components/video-hub/video-hub-shell';
+import { ChannelAvatar, VideoCard } from '@/components/video-hub/video-card';
+import { VideoPlayer } from '@/components/video-hub/video-player';
+import {
+  categoryLabel,
+  formatViews,
+  timeAgo,
+  videosHref,
+  youtubeChannelUrl,
+  youtubeWatchUrl,
+} from '@/lib/video-hub';
+import { getVideoWithRelated, isVideoHubEnabled } from '@/server/services/video-hub';
+
+export const dynamic = 'force-dynamic';
+
+async function load(id: string) {
+  if (!isVideoHubEnabled()) return null;
+  const safeId = decodeURIComponent(id).slice(0, 40);
+  return getVideoWithRelated(safeId).catch(() => null);
+}
+
+export async function generateMetadata({ params }: { params: Promise<{ id: string }> }): Promise<Metadata> {
+  const { id } = await params;
+  const data = await load(id);
+  return data?.item ? { title: data.item.title, description: `${data.item.channelTitle} · 도네이도 크리에이터 영상` } : { title: '영상' };
+}
+
+export default async function WatchPage({ params }: { params: Promise<{ id: string }> }) {
+  const { id } = await params;
+  const data = await load(id);
+  if (!data?.item) notFound();
+  const { item, related, now } = data;
+  const meta = [formatViews(item.views), timeAgo(item.publishedAt, now)].filter(Boolean).join(' · ');
+
+  return (
+    <VideoHubShell current="watch" activeCategory={item.category}>
+      <div className="mx-auto flex max-w-[1760px] flex-col gap-6 pt-4 lg:flex-row lg:pt-6">
+        <div className="min-w-0 flex-1">
+          {/* 모바일은 유튜브처럼 화면 가장자리까지, PC 는 둥근 카드 */}
+          <div className="-mx-3 sm:mx-0">
+            <VideoPlayer item={item} rounded="rounded-none sm:rounded-2xl" />
+          </div>
+
+          <h1 className="mt-3 text-[18px] font-black leading-snug tracking-[-0.02em] text-ink-900 sm:text-[20px]">{item.title}</h1>
+
+          <div className="mt-3 flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
+            <div className="flex min-w-0 items-center gap-3">
+              <ChannelAvatar title={item.channelTitle} className="h-10 w-10 text-[15px]" />
+              <div className="min-w-0">
+                <p className="truncate text-[15px] font-extrabold text-ink-900">{item.channelTitle}</p>
+                <p className="text-[12px] text-ink-400">
+                  {item.creator ? '도네이도 크리에이터' : '도네이도 미가입 크리에이터'}
+                </p>
+              </div>
+            </div>
+            <div className="flex flex-wrap gap-2">
+              {item.creator ? (
+                <Link
+                  href={`/c/${encodeURIComponent(item.creator.code)}`}
+                  className="inline-flex h-10 items-center gap-1.5 rounded-full bg-brand-400 px-4 text-[13.5px] font-extrabold text-ink-900 shadow-[0_6px_14px_rgba(237,166,0,0.28)] hover:bg-brand-500"
+                >
+                  <HeartHandshake size={16} strokeWidth={1.9} />
+                  후원하기
+                </Link>
+              ) : null}
+              {item.source === 'youtube' ? (
+                <>
+                  <a
+                    href={youtubeChannelUrl(item.channelId, true)}
+                    target="_blank"
+                    rel="noopener noreferrer"
+                    className="inline-flex h-10 items-center gap-1.5 rounded-full bg-ink-900 px-4 text-[13.5px] font-extrabold text-white hover:opacity-90"
+                  >
+                    <UserPlus size={16} strokeWidth={1.9} />
+                    유튜브에서 구독
+                  </a>
+                  <a
+                    href={youtubeWatchUrl(item.id)}
+                    target="_blank"
+                    rel="noopener noreferrer"
+                    className="inline-flex h-10 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-4 text-[13.5px] font-bold text-ink-700 hover:bg-ink-50"
+                  >
+                    <ExternalLink size={15} strokeWidth={1.8} />
+                    유튜브에서 보기
+                  </a>
+                </>
+              ) : null}
+            </div>
+          </div>
+
+          <div className="mt-3 rounded-2xl bg-warm-50 px-4 py-3 text-[13px] text-ink-700">
+            <p className="font-bold">
+              {meta}
+              <Link href={videosHref({ c: item.category })} className="ml-2 text-brand-700">
+                #{categoryLabel(item.category)}
+              </Link>
+            </p>
+            {item.creator ? (
+              <p className="mt-1.5 leading-relaxed text-ink-500">
+                문자 한 통으로 {item.creator.displayName} 님을 응원할 수 있어요. 후원하기를 누르면 후원 방법이 안내됩니다.
+              </p>
+            ) : item.source === 'sample' ? (
+              <p className="mt-1.5 flex items-start gap-1.5 leading-relaxed text-ink-500">
+                <Info size={15} strokeWidth={1.8} className="mt-0.5 shrink-0 text-brand-700" />
+                화면 구성을 보여 주기 위한 샘플입니다. 실제 채널이 등록되면 유튜브 영상이 재생됩니다.
+              </p>
+            ) : (
+              <p className="mt-1.5 leading-relaxed text-ink-500">
+                이 크리에이터는 아직 도네이도에 가입하지 않아 영상만 볼 수 있고 후원은 받을 수 없어요. 영상 정보는 유튜브에서
+                제공합니다.
+                <Link href="/creator-apply" className="ml-1 inline-flex items-center gap-0.5 font-extrabold text-brand-700">
+                  <Sparkles size={13} strokeWidth={1.9} />
+                  내 채널인가요? 크리에이터 가입
+                </Link>
+              </p>
+            )}
+          </div>
+        </div>
+
+        <aside className="w-full shrink-0 lg:w-[380px] 2xl:w-[420px]" aria-labelledby="related-title">
+          <h2 id="related-title" className="mb-2 px-1 text-[16px] font-black text-ink-900">관련 영상</h2>
+          {related.length > 0 ? (
+            <div className="space-y-1">
+              {related.map((v) => (
+                <VideoCard key={v.id} item={v} now={now} layout="row" />
+              ))}
+            </div>
+          ) : (
+            <p className="rounded-2xl bg-ink-50 px-4 py-6 text-center text-[13px] text-ink-500">관련 영상이 아직 없어요.</p>
+          )}
+        </aside>
+      </div>
+    </VideoHubShell>
+  );
+}
