+import * as React from 'react';
+import Link from 'next/link';
+import { CircleUserRound, Clapperboard, HeartHandshake, House, LayoutGrid, Map } from 'lucide-react';
+import { cx } from '@/components/ui';
+import { getSessionUser } from '@/server/auth';
+import { VIDEO_CATEGORIES, videosHref } from '@/lib/video-hub';
+import { VideoHubHeader } from './video-hub-header';
+
+/**
+ * 영상 전용 화면 틀 (유튜브형). PC·모바일이 같은 화면이고 폭에 따라 배치만 바뀐다.
+ *  - PC(lg 이상): 왼쪽 카테고리 사이드바 + 본문
+ *  - 모바일: 상단 바 + 본문 + 하단 탭
+ * 기존 공개 화면 틀(PublicShell)과 분리되어 있어 서로 영향을 주지 않는다.
+ */
+export async function VideoHubShell({
+  children,
+  activeCategory = 'all',
+  q = '',
+  current = 'videos',
+}: {
+  children: React.ReactNode;
+  activeCategory?: string;
+  q?: string;
+  current?: 'videos' | 'watch';
+}) {
+  const user = await getSessionUser().catch(() => null);
+  const myHref = user?.role === 'ADMIN' ? '/admin' : user?.role === 'CREATOR' ? '/studio' : '/my';
+
+  return (
+    <div className="min-h-dvh bg-[#fffdf7] text-ink-900">
+      <VideoHubHeader q={q} myHref={myHref} loggedIn={Boolean(user)} />
+
+      <div className="mx-auto flex w-full max-w-[2000px]">
+        <aside
+          className="sticky top-16 hidden h-[calc(100dvh-4rem)] w-[224px] shrink-0 overflow-y-auto border-r border-warm-100 px-3 py-4 lg:block"
+          aria-label="영상 카테고리"
+        >
+          <nav className="space-y-0.5">
+            <SideLink href="/" icon={<House size={18} strokeWidth={1.8} />} label="도네이도 홈" />
+            <SideLink
+              href="/videos"
+              icon={<LayoutGrid size={18} strokeWidth={1.8} />}
+              label="전체 영상"
+              active={current === 'videos' && activeCategory === 'all' && !q}
+            />
+            <SideLink
+              href={videosHref({ c: 'donaido' })}
+              icon={<HeartHandshake size={18} strokeWidth={1.8} />}
+              label="후원 가능"
+              active={current === 'videos' && activeCategory === 'donaido'}
+            />
+          </nav>
+          <p className="mb-1.5 mt-5 px-3 text-[12px] font-extrabold text-ink-400">카테고리</p>
+          <nav className="space-y-0.5">
+            {VIDEO_CATEGORIES.filter((c) => c.slug !== 'all' && c.slug !== 'donaido').map((c) => (
+              <SideLink
+                key={c.slug}
+                href={videosHref({ c: c.slug })}
+                label={c.label}
+                active={current === 'videos' && activeCategory === c.slug}
+              />
+            ))}
+          </nav>
+          <div className="mt-6 rounded-2xl border border-warm-200 bg-warm-50 p-3 text-[12px] leading-relaxed text-ink-500">
+            <p className="font-extrabold text-ink-700">크리에이터이신가요?</p>
+            <p className="mt-1">도네이도에 가입하면 영상 옆에 후원하기 버튼이 붙어요.</p>
+            <Link href="/creator-apply" className="mt-2 inline-block font-extrabold text-brand-700">
+              크리에이터 가입
+            </Link>
+          </div>
+        </aside>
+
+        <main className="min-w-0 flex-1 px-3 pb-28 pt-0 sm:px-5 lg:pb-12">{children}</main>
+      </div>
+
+      <nav
+        className="fixed inset-x-0 bottom-0 z-40 border-t border-warm-200 bg-white/95 pb-[env(safe-area-inset-bottom)] backdrop-blur lg:hidden"
+        aria-label="하단 메뉴"
+      >
+        <div className="mx-auto grid max-w-[640px] grid-cols-4">
+          <BottomLink href="/" icon={<House size={19} strokeWidth={1.75} />} label="홈" />
+          <BottomLink href="/videos" icon={<Clapperboard size={19} strokeWidth={1.75} />} label="영상" active />
+          <BottomLink href="/how-it-works" icon={<Map size={19} strokeWidth={1.75} />} label="이용방법" />
+          <BottomLink href={user ? myHref : '/login'} icon={<CircleUserRound size={19} strokeWidth={1.75} />} label="마이페이지" />
+        </div>
+      </nav>
+    </div>
+  );
+}
+
+function SideLink({ href, label, icon, active = false }: { href: string; label: string; icon?: React.ReactNode; active?: boolean }) {
+  return (
+    <Link
+      href={href}
+      aria-current={active ? 'page' : undefined}
+      className={cx(
+        'flex h-10 items-center gap-3 rounded-xl px-3 text-[14px] transition-colors',
+        active ? 'bg-brand-100 font-extrabold text-ink-900' : 'font-semibold text-ink-700 hover:bg-ink-50',
+      )}
+    >
+      {icon ?? <span className="h-1.5 w-1.5 rounded-full bg-ink-300" aria-hidden />}
+      {label}
+    </Link>
+  );
+}
+
+function BottomLink({ href, label, icon, active = false }: { href: string; label: string; icon: React.ReactNode; active?: boolean }) {
+  return (
+    <Link
+      href={href}
+      className={cx('flex min-h-16 flex-col items-center justify-center gap-1 py-2 text-[11px] font-semibold', active ? 'text-brand-700' : 'text-ink-400')}
+    >
+      <span
+        className={cx(
+          'grid h-8 w-8 place-items-center rounded-[11px] border',
+          active ? 'border-brand-300 bg-brand-400 text-ink-900 shadow-sm' : 'border-transparent bg-ink-50 text-ink-400',
+        )}
+      >
+        {icon}
+      </span>
+      {label}
+    </Link>
+  );
+}
+
+/** 상단 고정 카테고리 칩 줄 (유튜브 홈 상단과 같은 역할) */
+export function VideoCategoryChips({ active, q }: { active: string; q?: string }) {
+  return (
+    <div className="sticky top-14 z-30 -mx-3 bg-[#fffdf7]/95 px-3 py-2.5 backdrop-blur sm:top-16 sm:-mx-5 sm:px-5">
+      <div className="flex gap-2 overflow-x-auto [scrollbar-width:none]" role="tablist" aria-label="영상 카테고리">
+        {VIDEO_CATEGORIES.map((c) => {
+          const on = active === c.slug;
+          return (
+            <Link
+              key={c.slug}
+              href={videosHref({ c: c.slug, q })}
+              role="tab"
+              aria-selected={on}
+              className={cx(
+                'inline-flex h-8 shrink-0 items-center rounded-lg px-3 text-[13px] font-bold transition-colors',
+                on ? 'bg-ink-900 text-white' : 'bg-ink-100 text-ink-700 hover:bg-ink-200',
+              )}
+            >
+              {c.label}
+            </Link>
+          );
+        })}
+      </div>
+    </div>
+  );
+}
