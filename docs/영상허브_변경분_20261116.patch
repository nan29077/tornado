diff --git a/src/components/video-hub/video-card.tsx b/src/components/video-hub/video-card.tsx
new file mode 100755
index 0000000..22ae7c3
--- /dev/null
+++ b/src/components/video-hub/video-card.tsx
@@ -0,0 +1,135 @@
+import * as React from 'react';
+import Link from 'next/link';
+import { HeartHandshake, PlayCircle } from 'lucide-react';
+import { cx } from '@/components/ui';
+import { formatViews, timeAgo, type VideoItem } from '@/lib/video-hub';
+
+/**
+ * 영상 카드 (유튜브형).
+ * 서버·클라이언트 양쪽에서 쓰는 표시 전용 컴포넌트라 훅을 쓰지 않는다.
+ * - onSelect 가 있으면 버튼(메인 좌측 영역의 바로 재생), 없으면 /watch 로 가는 링크.
+ * - now 는 서버가 정한 기준 시각. 서버·브라우저의 "N분 전" 표기가 어긋나지 않게 한다.
+ */
+
+export function VideoThumb({ item, className, rounded = 'rounded-xl' }: { item: VideoItem; className?: string; rounded?: string }) {
+  return (
+    <div className={cx('relative aspect-video w-full overflow-hidden bg-ink-100', rounded, className)}>
+      {item.thumbnail ? (
+        // 유튜브 썸네일(i.ytimg.com)은 next/image 최적화 대상에서 뺀다 (원격 도메인 설정을 늘리지 않는다).
+        // eslint-disable-next-line @next/next/no-img-element
+        <img
+          src={item.thumbnail}
+          alt=""
+          loading="lazy"
+          decoding="async"
+          width={480}
+          height={360}
+          className="absolute inset-0 h-full w-full object-cover"
+        />
+      ) : (
+        <div className="absolute inset-0 grid place-items-center bg-[linear-gradient(135deg,#fff3cf_0%,#ffd77a_55%,#f2b541_100%)] text-brand-800">
+          <PlayCircle size={34} strokeWidth={1.5} />
+        </div>
+      )}
+      <div className="absolute left-1.5 top-1.5 flex gap-1">
+        {item.source === 'sample' ? (
+          <span className="rounded-md bg-ink-900/80 px-1.5 py-0.5 text-[10.5px] font-bold text-white">샘플</span>
+        ) : null}
+        {item.isShort ? (
+          <span className="rounded-md bg-ink-900/80 px-1.5 py-0.5 text-[10.5px] font-bold text-white">쇼츠</span>
+        ) : null}
+      </div>
+      {item.creator ? (
+        <span className="absolute bottom-1.5 right-1.5 inline-flex items-center gap-1 rounded-md bg-brand-400 px-1.5 py-0.5 text-[10.5px] font-extrabold text-ink-900 shadow-sm">
+          <HeartHandshake size={12} strokeWidth={2} />
+          후원 가능
+        </span>
+      ) : null}
+    </div>
+  );
+}
+
+export function ChannelAvatar({ title, className }: { title: string; className?: string }) {
+  // 채널 아이콘은 RSS 에 없다. 채널명 첫 글자로 대신한다.
+  return (
+    <span
+      aria-hidden
+      className={cx(
+        'grid shrink-0 place-items-center rounded-full bg-brand-100 font-extrabold text-brand-800',
+        className ?? 'h-9 w-9 text-[13px]',
+      )}
+    >
+      {Array.from(title.trim())[0] ?? '?'}
+    </span>
+  );
+}
+
+function Meta({ item, now }: { item: VideoItem; now: number }) {
+  const views = formatViews(item.views);
+  const ago = timeAgo(item.publishedAt, now);
+  return (
+    <p className="mt-0.5 truncate text-[12px] text-ink-400">
+      {[views, ago].filter(Boolean).join(' · ')}
+    </p>
+  );
+}
+
+export function VideoCard({
+  item,
+  now,
+  onSelect,
+  active = false,
+  layout = 'grid',
+  className,
+}: {
+  item: VideoItem;
+  now: number;
+  onSelect?: (item: VideoItem) => void;
+  active?: boolean;
+  /** grid: 유튜브 홈형(세로) / row: 시청 화면 우측 목록형(가로) */
+  layout?: 'grid' | 'row';
+  className?: string;
+}) {
+  const body =
+    layout === 'row' ? (
+      <div className="flex gap-2.5 text-left">
+        {/* 폭은 감싸는 상자가 정한다 (VideoThumb 기본 w-full 과 폭 클래스가 충돌하지 않게) */}
+        <div className="w-[168px] shrink-0">
+          <VideoThumb item={item} rounded="rounded-lg" />
+        </div>
+        <div className="min-w-0 flex-1">
+          <p className="line-clamp-2 text-[13.5px] font-bold leading-snug text-ink-900">{item.title}</p>
+          <p className="mt-1 truncate text-[12px] text-ink-500">{item.channelTitle}</p>
+          <Meta item={item} now={now} />
+        </div>
+      </div>
+    ) : (
+      <div className="text-left">
+        <VideoThumb item={item} />
+        <div className="mt-2.5 flex gap-2.5">
+          <ChannelAvatar title={item.channelTitle} />
+          <div className="min-w-0 flex-1">
+            <p className="line-clamp-2 text-[14px] font-bold leading-snug text-ink-900">{item.title}</p>
+            <p className="mt-1 truncate text-[12.5px] text-ink-500">{item.channelTitle}</p>
+            <Meta item={item} now={now} />
+          </div>
+        </div>
+      </div>
+    );
+
+  const cls = cx(
+    'group block w-full rounded-2xl p-1.5 transition-colors hover:bg-brand-50/70 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand-500',
+    active && 'bg-brand-50 ring-1 ring-brand-200',
+    className,
+  );
+
+  return onSelect ? (
+    <button type="button" onClick={() => onSelect(item)} className={cls} aria-pressed={active} aria-label={`${item.title} 재생`}>
+      {body}
+    </button>
+  ) : (
+    <Link href={`/watch/${encodeURIComponent(item.id)}`} className={cls} prefetch={false}>
+      {body}
+    </Link>
+  );
+}
