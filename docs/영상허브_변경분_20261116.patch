+      )}
+
+      <Link
+        href={videosHref({ c: cat })}
+        className="mt-4 flex h-11 items-center justify-center gap-1.5 rounded-xl border border-ink-200 bg-white text-[13.5px] font-extrabold text-ink-900 shadow-sm transition-all hover:-translate-y-0.5 hover:bg-ink-50"
+      >
+        영상 더보기
+        <ArrowRight size={15} strokeWidth={2} />
+      </Link>
+
+      {sample ? (
+        <p className="mt-3 text-center text-[11.5px] leading-relaxed text-ink-400">
