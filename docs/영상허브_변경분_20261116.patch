@@ -0,0 +1,30 @@
+import * as React from 'react';
+import { getVideoFeed } from '@/server/services/video-hub';
+import { HomeVideoPane } from './home-video-pane';
+import { HomeVideoSection } from './home-video-section';
+
+/**
+ * 메인 화면용 데이터 로더 (서버 컴포넌트).
+ * 메인에서는 <Suspense> 로 감싸 쓴다 — 유튜브 피드를 기다리는 동안에도 메인 화면은 먼저 뜬다.
+ * 어떤 오류든 영상 영역만 비우고 메인 화면은 그대로 둔다.
+ */
+async function loadHomeVideos() {
+  try {
+    const feed = await getVideoFeed();
+    return { items: feed.items.slice(0, 60), sample: feed.sample, now: feed.now };
+  } catch {
+    return { items: [], sample: false, now: 0 };
+  }
+}
+
+export async function HomeVideoPaneLoader() {
+  const { items, sample, now } = await loadHomeVideos();
+  if (items.length === 0) return null;
+  return <HomeVideoPane items={items} sample={sample} now={now} />;
+}
+
+export async function HomeVideoSectionLoader() {
+  const { items, sample, now } = await loadHomeVideos();
+  if (items.length === 0) return null;
+  return <HomeVideoSection items={items} sample={sample} now={now} />;
+}
