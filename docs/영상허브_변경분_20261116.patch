diff --git a/src/app/videos/page.tsx b/src/app/videos/page.tsx
new file mode 100755
index 0000000..47a527e
--- /dev/null
+++ b/src/app/videos/page.tsx
@@ -0,0 +1,136 @@
+import type { Metadata } from 'next';
+import Link from 'next/link';
+import { notFound } from 'next/navigation';
+import { ArrowDown, Info, SearchX } from 'lucide-react';
+import { VideoHubShell, VideoCategoryChips } from '@/components/video-hub/video-hub-shell';
+import { VideoCard } from '@/components/video-hub/video-card';
+import { categoryLabel, isVideoCategory, videosHref, type VideoItem } from '@/lib/video-hub';
+import { getVideos, isVideoHubEnabled } from '@/server/services/video-hub';
+
+export const dynamic = 'force-dynamic';
+
+export const metadata: Metadata = {
+  title: '크리에이터 영상',
+  description: '카테고리별 크리에이터 최신 영상을 모아 보고, 도네이도 가입 크리에이터에게는 바로 후원하세요.',
+};
+
+const PAGE = 24;
+const MAX = 240;
+
+function first(v: string | string[] | undefined): string {
+  return (Array.isArray(v) ? v[0] : v) ?? '';
+}
+
+export default async function VideosPage({
+  searchParams,
+}: {
+  searchParams: Promise<{ c?: string | string[]; q?: string | string[]; limit?: string | string[] }>;
+}) {
+  if (!isVideoHubEnabled()) notFound();
+  const sp = await searchParams;
+  const cRaw = first(sp.c);
+  const c = isVideoCategory(cRaw) ? cRaw : 'all';
+  const q = first(sp.q).trim().slice(0, 50);
+  const limitNum = Number.parseInt(first(sp.limit), 10);
+  const limit = Number.isFinite(limitNum) ? Math.min(Math.max(limitNum, PAGE), MAX) : PAGE;
+
+  const { items, sample, now } = await getVideos({ c, q }).catch(() => ({ items: [] as VideoItem[], sample: false, now: 0 }));
+
+  // 유튜브 홈처럼: 전체 보기 첫 화면에서는 일반 영상 사이에 쇼츠 선반을 끼운다.
+  const showShelf = c === 'all' && !q;
+  const shorts = showShelf ? items.filter((v) => v.isShort).slice(0, 12) : [];
+  const main = showShelf && shorts.length > 0 ? items.filter((v) => !v.isShort) : items;
+  const visible = main.slice(0, limit);
+  const head = visible.slice(0, 8);
+  const rest = visible.slice(8);
+
+  return (
+    <VideoHubShell activeCategory={c} q={q}>
+      <VideoCategoryChips active={c} q={q} />
+
+      {q ? (
+        <h1 className="mt-2 text-[15px] font-bold text-ink-700">
+          <span className="text-ink-900">&lsquo;{q}&rsquo;</span> 검색 결과 {items.length.toLocaleString('ko-KR')}개
+          {c !== 'all' ? <span className="text-ink-400"> · {categoryLabel(c)}</span> : null}
+        </h1>
+      ) : (
+        <h1 className="sr-only">{c === 'all' ? '전체 영상' : `${categoryLabel(c)} 영상`}</h1>
+      )}
+
+      {sample ? (
+        <p className="mt-2 flex items-start gap-1.5 rounded-xl bg-warm-50 px-3 py-2 text-[12.5px] leading-relaxed text-ink-500">
+          <Info size={15} strokeWidth={1.8} className="mt-0.5 shrink-0 text-brand-700" />
+          아직 등록된 유튜브 채널이 없어 샘플 영상을 보여 주고 있어요. 샘플은 재생되지 않습니다.
+        </p>
+      ) : null}
+
+      {visible.length === 0 && shorts.length === 0 ? (
+        <div className="mx-auto mt-16 max-w-sm text-center">
+          <SearchX size={40} strokeWidth={1.4} className="mx-auto text-ink-300" />
+          <p className="mt-3 text-[15px] font-extrabold text-ink-900">{q ? '검색 결과가 없어요' : '아직 영상이 없어요'}</p>
+          <p className="mt-1 text-[13px] text-ink-500">다른 카테고리를 골라 보거나 검색어를 바꿔 보세요.</p>
+          <Link href="/videos" className="mt-4 inline-block text-[13.5px] font-extrabold text-brand-700">
+            전체 영상 보기
+          </Link>
+        </div>
+      ) : (
+        <>
+          <VideoGrid items={head} now={now} />
+          {shorts.length > 0 ? (
+            <section className="mt-6" aria-labelledby="shorts-title">
+              <h2 id="shorts-title" className="mb-2 px-1 text-[17px] font-black text-ink-900">쇼츠</h2>
+              <div className="-mx-3 flex gap-2 overflow-x-auto px-3 pb-2 [scrollbar-width:none] sm:-mx-5 sm:px-5">
+                {shorts.map((v) => (
+                  <ShortCard key={v.id} item={v} />
+                ))}
+              </div>
+            </section>
+          ) : null}
+          {rest.length > 0 ? <VideoGrid items={rest} now={now} /> : null}
+          {main.length > visible.length ? (
+            <div className="mt-6 flex justify-center">
+              <Link
+                href={videosHref({ c, q, limit: limit + PAGE })}
+                scroll={false}
+                className="inline-flex h-11 items-center gap-1.5 rounded-full border border-ink-200 bg-white px-6 text-[13.5px] font-extrabold text-ink-900 shadow-sm hover:bg-ink-50"
+              >
+                더 불러오기
+                <ArrowDown size={15} strokeWidth={2} />
+              </Link>
+            </div>
+          ) : null}
+        </>
+      )}
+    </VideoHubShell>
+  );
+}
+
+function VideoGrid({ items, now }: { items: VideoItem[]; now: number }) {
+  if (items.length === 0) return null;
+  return (
+    <div className="mt-3 grid grid-cols-1 gap-x-3 gap-y-5 sm:grid-cols-2 lg:grid-cols-3 2xl:grid-cols-4 min-[1900px]:grid-cols-5">
+      {items.map((v) => (
+        <VideoCard key={v.id} item={v} now={now} />
+      ))}
+    </div>
+  );
+}
+
+function ShortCard({ item }: { item: VideoItem }) {
+  return (
+    <Link href={`/watch/${encodeURIComponent(item.id)}`} prefetch={false} className="w-[150px] shrink-0 sm:w-[180px]">
+      <div className="relative aspect-[9/16] overflow-hidden rounded-xl bg-ink-100">
+        {item.thumbnail ? (
+          // eslint-disable-next-line @next/next/no-img-element
+          <img src={item.thumbnail} alt="" loading="lazy" decoding="async" className="absolute inset-0 h-full w-full object-cover" />
+        ) : (
+          <div className="absolute inset-0 bg-[linear-gradient(160deg,#fff3cf_0%,#ffd77a_55%,#f2b541_100%)]" />
+        )}
+        {item.source === 'sample' ? (
+          <span className="absolute left-1.5 top-1.5 rounded-md bg-ink-900/80 px-1.5 py-0.5 text-[10.5px] font-bold text-white">샘플</span>
+        ) : null}
+      </div>
+      <p className="mt-1.5 line-clamp-2 text-[13px] font-bold leading-snug text-ink-900">{item.title}</p>
+    </Link>
+  );
+}
