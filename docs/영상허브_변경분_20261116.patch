+import { ArrowLeft, CircleUserRound, House, LogIn, Search } from 'lucide-react';
+import { Logo } from '@/components/brand/logo';
+import { cx } from '@/components/ui';
+
+/**
+ * 영상 화면(/videos, /watch) 상단 바. 유튜브처럼 로고 · 검색 · 계정.
+ * 모바일에서는 검색 아이콘을 누르면 검색창이 상단 전체로 펼쳐진다.
+ * 검색은 일반 GET 폼이라 자바스크립트가 없어도 동작한다.
+ */
+export function VideoHubHeader({
+  q = '',
+  myHref,
+  loggedIn,
+}: {
+  q?: string;
+  myHref: string;
+  loggedIn: boolean;
+}) {
+  const [searchOpen, setSearchOpen] = React.useState(false);
+  const inputRef = React.useRef<HTMLInputElement>(null);
+
+  React.useEffect(() => {
+    if (searchOpen) inputRef.current?.focus();
+  }, [searchOpen]);
+
+  // 모바일 펼침 검색창과 PC 검색창이 동시에 DOM 에 있을 수 있어 id 를 나눈다 (중복 id 방지)
+  const renderForm = (id: string, withRef: boolean) => (
+    <form action="/videos" method="get" role="search" className="flex w-full items-center">
+      {/* 검색은 유튜브처럼 전체 카테고리에서 한다. 결과 화면의 칩으로 다시 좁힐 수 있다. */}
