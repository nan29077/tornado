  tokenMasked   String   @map("token_masked")
  enabled       Boolean  @default(true)
  showAmount    Boolean  @default(true) @map("show_amount")
  showMessage   Boolean  @default(true) @map("show_message")
  maxMessageLen Int      @default(80) @map("max_message_len")
  anonymize     Boolean  @default(false)
  position      String   @default("BOTTOM_CENTER")
  durationMs    Int      @default(7000) @map("duration_ms")
  theme         String   @default("TORNADO")
  stickerSet    String   @default("DEFAULT") @map("sticker_set")
  /// 효과음 재생 여부와 음량(0~100). 효과음은 오버레이에서 Web Audio 로 직접 합성한다.
  soundEnabled  Boolean  @default(true) @map("sound_enabled")
  soundVolume   Int      @default(80) @map("sound_volume")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("overlay_setting")
