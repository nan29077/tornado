/// APPEND ONLY. 어떤 경로로도 UPDATE/DELETE 하지 않는다. 정정은 반대분개로 처리.
model SettlementLedger {
  id            String          @id
  creatorId     String          @map("creator_id")
  entryType     LedgerEntryType @map("entry_type")
  /// 부호 있는 금액. 크리에이터 수취 증가는 +, 차감은 -
  amount        BigInt
  donationId    String?         @map("donation_id")
  refundId      String?         @map("refund_id")
  requestId     String?         @map("request_id")
  memo          String?
  occurredAt    DateTime        @map("occurred_at") @db.Timestamptz(3)
  settlementKey String          @map("settlement_key")
  createdAt     DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  creator  CreatorProfile     @relation(fields: [creatorId], references: [id])
  donation Donation?          @relation(fields: [donationId], references: [id])
  request  SettlementRequest? @relation(fields: [requestId], references: [id])

  @@index([creatorId, occurredAt])
  @@index([settlementKey])
  @@index([donationId])
  // 전체 원장 탭(크리에이터 미선택) 기본 정렬.
  @@index([occurredAt])
  @@map("settlement_ledger")
}

model SettlementRequest {
  id             String                  @id
  creatorId      String                  @map("creator_id")
  amount         BigInt
  status         SettlementRequestStatus @default(REQUESTED)
  /// 원천징수 합계 = 소득세 + 지방소득세
  withholding    BigInt                  @default(0)
  /// 소득세 (지급액의 3%, 10원 미만 절사). 지급명세서는 소득세/지방소득세를 따로 적는다.
  incomeTax      BigInt                  @default(0) @map("income_tax")
  /// 지방소득세 (소득세의 10%, 10원 미만 절사)
  localTax       BigInt                  @default(0) @map("local_tax")
  payoutAmount   BigInt                  @default(0) @map("payout_amount")
  /// 지급대행 이체파일 발급 배치번호. 값이 있으면 이미 이체파일이 나간 건(재발급 시 이중이체 경고).
  payoutBatchNo  String?                 @map("payout_batch_no")
  /// 이체파일 최초 발급 시각
  payoutIssuedAt DateTime?               @map("payout_issued_at") @db.Timestamptz(3)
  /// 크리에이터가 남기는 메모
  memo           String?
  /// 관리자 처리 메모(반려 사유 등). 크리에이터에게 노출된다.
  adminMemo      String?                 @map("admin_memo")
  adminId        String?                 @map("admin_id")

  /// 원천징수 신고용 주민등록번호(암호화). 신고 완료 시 파기한다.
  residentEnc        String?   @map("resident_enc")
  /// 마스킹 표기(예: 901010-1******). 원문은 화면에 노출하지 않는다.
  residentMasked     String?   @map("resident_masked")
  /// 주민등록번호 파기 시각. 값이 있으면 원문은 이미 삭제된 상태다.
  residentPurgedAt   DateTime? @map("resident_purged_at") @db.Timestamptz(3)
  /// 원천징수 지급명세서 신고 완료 시각.
  withholdingFiledAt DateTime? @map("withholding_filed_at") @db.Timestamptz(3)

  /// 지급대행(쿠콘) 처리 참조번호.
  payoutRef        String? @map("payout_ref")
  /// 지급 실패 사유(PAYOUT_FAILED).
  payoutFailReason String? @map("payout_fail_reason")

  requestedAt DateTime  @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedAt  DateTime? @map("approved_at") @db.Timestamptz(3)
  paidAt      DateTime? @map("paid_at") @db.Timestamptz(3)
  rejectedAt  DateTime? @map("rejected_at") @db.Timestamptz(3)

  creator CreatorProfile     @relation(fields: [creatorId], references: [id])
  entries SettlementLedger[]

  @@index([creatorId, requestedAt])
  @@index([status])
  @@map("settlement_request")
}

