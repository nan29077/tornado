// ---------------------------------------------------------------------------
// TORNADO (토네이도) - 문자후원 플랫폼 데이터 모델
// Target: PostgreSQL 16 (Amazon RDS / Aurora PostgreSQL 호환)
//
// 설계 원칙
//  - ID 는 애플리케이션에서 생성(ULID 문자열). DB 함수 의존 제거
//  - 모든 시각은 timestamptz(UTC) 저장, 표시 시점에 Asia/Seoul 변환
//  - 금액은 BigInt (원 단위 정수). 부동소수점 금지
//  - 요율은 Decimal(10,6)
//  - 개인정보/금융정보는 해시 + 봉투암호화 + 마스킹 3분리 저장
//  - 정산 원장(settlement_ledger)은 append-only (수정/삭제 금지, 정정은 반대분개)
//  - 테이블/컬럼명은 snake_case (DBA 인수인계 고려)
// ---------------------------------------------------------------------------

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ===========================================================================
// ENUMS
// ===========================================================================

enum UserRole {
  DONOR
  CREATOR
  ADMIN

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  WITHDRAWN

  @@map("user_status")
}

enum CreatorStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED

  @@map("creator_status")
}

enum MoNumberStatus {
  AVAILABLE
  RESERVED
  ASSIGNED
  RECLAIMED
  DISABLED

  @@map("mo_number_status")
}

/// DEDICATED     : 크리에이터 전용 수신번호
/// SHARED_PREFIX : 대표번호 공유 + 문자 앞 키워드로 크리에이터 식별
enum MoRouteMode {
  DEDICATED
  SHARED_PREFIX

  @@map("mo_route_mode")
}

enum MessageType {
  SMS
  LMS
  MMS

  @@map("message_type")
}

enum MoProcessResult {
  PENDING
  ROUTED
  UNKNOWN_ROUTE
  DUPLICATE
  UNREGISTERED_DONOR
  BLOCKED
  ERROR

  @@map("mo_process_result")
}

/// 후원 거래 상태머신
enum DonationStatus {
  RECEIVED
  UNREGISTERED
  LIMIT_BLOCKED
  CONTENT_BLOCKED
  PENDING_CONFIRM
  /// 결제사(헥토/카드) PIN 인증 대기. 후원자가 PIN 을 입력해야 승인 단계로 넘어간다.
  PENDING_PIN
  PENDING_PAYMENT
  PAYMENT_SUCCESS
  PAYMENT_FAILED
  BROADCAST_PENDING
  BROADCASTED
  PARTIAL_DELIVERY_FAILED
  REFUND_REQUESTED
  REFUNDED
  SETTLEMENT_PENDING
  SETTLED

  @@map("donation_status")
}

enum PaymentMode {
  DIRECT_TRIGGER
  CONFIRM_LINK

  @@map("payment_mode")
}

enum PaymentTxStatus {
  REQUESTED
  APPROVED
  FAILED
  CANCELED
  TIMEOUT
  UNKNOWN

  @@map("payment_tx_status")
}

enum PaymentTokenStatus {
  ACTIVE
  REVOKED
  EXPIRED

  @@map("payment_token_status")
}

enum RegistrationStatus {
  STARTED
  AUTH_DONE
  COMPLETED
  FAILED
  EXPIRED

  @@map("registration_status")
}

/// 전화번호 기준 내통장결제 가입 상태.
enum DonorOnboardingStatus {
  UNREGISTERED
  LINK_SENT
  REGISTERED
  SUSPENDED
  WITHDRAWN

  @@map("donor_onboarding_status")
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  SKIPPED

  @@map("delivery_status")
}

enum RefundStatus {
  REQUESTED
  APPROVED
  /// PG 취소 API 가 타임아웃/네트워크 오류로 결과를 확인하지 못한 상태.
  /// APPROVED 에 영구 고착시키지 않고, 재시도(수동 또는 배치)로 이어갈 수 있게 분리한다.
  PENDING_RECOVERY
  REJECTED
  DONE
  FAILED

  @@map("refund_status")
}

enum SecureLinkPurpose {
  REGISTER_ACCOUNT
  CONFIRM_PAYMENT
  MANAGE_DONOR

  @@map("secure_link_purpose")
}

enum PolicyScope {
  GLOBAL
  CREATOR
  DONOR

  @@map("policy_scope")
}

enum LedgerEntryType {
  DONATION_GROSS
  PG_FEE
  PLATFORM_FEE
  REFUND
  REFUND_FEE_RETURN
  ADJUSTMENT
  PAYOUT
  PAYOUT_WITHHOLDING

  @@map("ledger_entry_type")
}

enum SettlementRequestStatus {
  REQUESTED
  REVIEWING
  APPROVED
  PAID
  PAYOUT_FAILED
  REJECTED

  @@map("settlement_request_status")
}

enum ConsentType {
  TERMS_SERVICE
  PRIVACY
  E_FINANCE
  WITHDRAWAL_AGREE
  AGE_CONFIRM
  MARKETING

  @@map("consent_type")
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL

  @@map("risk_level")
}

enum RiskType {
  VELOCITY
  DAILY_LIMIT
  MONTHLY_LIMIT
  REPEATED_FAILURE
  NEW_DONOR
  MANUAL_REVIEW
  DUPLICATE_WEBHOOK
  ABNORMAL_AMOUNT
  /// 결제 승인 결과를 확인하지 못한 건. 결제사 원장과 수동 대사가 필요하다.
  PAYMENT_UNKNOWN

  @@map("risk_type")
}

enum ContentAction {
  BLOCK
  MASK
  FLAG

  @@map("content_action")
}

enum YouTubeConnectionStatus {
  CONNECTED
  EXPIRED
  REVOKED
  ERROR

  @@map("youtube_connection_status")
}

enum ReportStatus {
  OPEN
  REVIEWING
  RESOLVED
  DISMISSED

  @@map("report_status")
}

enum NotificationChannel {
  MT_SMS
  EMAIL
  IN_APP

  @@map("notification_channel")
}

enum AdminPermission {
  SUPER_ADMIN
  OPERATION
  FINANCE
  SUPPORT
  READ_ONLY

  @@map("admin_permission")
}

// ===========================================================================
// 계정 / 사용자
// ===========================================================================

model User {
  id              String     @id
  email           String?    @unique
  passwordHash    String?    @map("password_hash")
  role            UserRole   @default(DONOR)
  status          UserStatus @default(ACTIVE)
  name            String?
  /// 50종 개별 기본 프로필 캐릭터 번호(0~49). 계정 생성 시 DB에서 무작위 배정되어 유지된다.
  avatarIndex     Int        @default(dbgenerated("(floor((random() * (50)::double precision)))::integer")) @map("avatar_index")
  /// 검색용 HMAC-SHA256 해시 (키는 KMS 관리)
  phoneHash       String?    @unique @map("phone_hash")
  /// KMS 봉투암호화 결과 (원문 저장 금지)
  phoneEnc        String?    @map("phone_enc")
  /// 010-****-1234
  phoneMasked     String?    @map("phone_masked")
  ageVerified     Boolean    @default(false) @map("age_verified")
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  twoFactorSecret String?    @map("two_factor_secret")
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)
  deletedAt       DateTime?  @map("deleted_at") @db.Timestamptz(3)

  donorProfile   DonorProfile?
  creatorProfile CreatorProfile?
  adminProfile   AdminProfile?
  sessions       UserSession[]
  consents       ConsentRecord[]
  notifications  Notification[]
  passwordResets PasswordResetToken[]

  @@index([role, status])
  @@map("app_user")
}

model UserSession {
  id        String    @id
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  ip        String?
  userAgent String?   @map("user_agent")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_session")
}

/// 비밀번호 재설정 1회용 토큰.
/// 원문 토큰은 메일(현재는 콘솔/화면)로만 전달하고 DB 에는 해시만 남긴다.
model PasswordResetToken {
  id        String    @id
  userId    String    @map("user_id")
  /// tokenHash(SESSION_SECRET HMAC). 원문 저장 금지.
  tokenHash String    @unique @map("token_hash")
  requestIp String?   @map("request_ip")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(3)
  usedIp    String?   @map("used_ip")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_token")
}

model AdminProfile {
  id         String          @id
  userId     String          @unique @map("user_id")
  permission AdminPermission @default(READ_ONLY)
  memo       String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  auditLogs AdminAuditLog[]

  @@map("admin_profile")
}

// ===========================================================================
// 후원자
// ===========================================================================

model DonorProfile {
  id                     String                @id
  userId                 String?               @unique @map("user_id")
  /// 후원자 식별의 기준. 회원가입 없이 문자만으로도 생성됨
  phoneHash              String                @unique @map("phone_hash")
  phoneEnc               String                @map("phone_enc")
  phoneMasked            String                @map("phone_masked")
  displayName            String?               @map("display_name")
  /// SNS 플랫폼 (YOUTUBE | INSTAGRAM | FACEBOOK | TIKTOK | OTHER). 닉네임과 세트로 관리.
  snsPlatform            String?               @map("sns_platform")
  ageVerified            Boolean               @default(false) @map("age_verified")
  /// 후원자 개인 한도 (미설정 시 전역 정책 적용)
  dailyLimit             BigInt?               @map("daily_limit")
  monthlyLimit           BigInt?               @map("monthly_limit")
  failCount              Int                   @default(0) @map("fail_count")
  lockedUntil            DateTime?             @map("locked_until") @db.Timestamptz(3)
  blockedAt              DateTime?             @map("blocked_at") @db.Timestamptz(3)
  blockedReason          String?               @map("blocked_reason")
  firstSeenAt            DateTime              @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  registeredAt           DateTime?             @map("registered_at") @db.Timestamptz(3)
  onboardingStatus       DonorOnboardingStatus @default(UNREGISTERED) @map("onboarding_status")
  registrationLinkSentAt DateTime?             @map("registration_link_sent_at") @db.Timestamptz(3)
  createdAt              DateTime              @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt              DateTime              @updatedAt @map("updated_at") @db.Timestamptz(3)

  user          User?                 @relation(fields: [userId], references: [id])
  paymentTokens PaymentMethodToken[]
  registrations PaymentRegistration[]
  creatorLinks  DonorCreatorLink[]
  donations     Donation[]
  counters      DonationCounter[]
  risks         RiskDetection[]
  blockedBy     BlockedDonor[]
  gameEntries   GameParticipant[]

  @@index([lockedUntil])
  @@index([onboardingStatus])
  @@map("donor_profile")
}

/// 후원자 x 크리에이터 관계 (동의/차단/누적)
model DonorCreatorLink {
  id             String    @id
  donorId        String    @map("donor_id")
  creatorId      String    @map("creator_id")
  consentedAt    DateTime? @map("consented_at") @db.Timestamptz(3)
  /// 후원자가 이 크리에이터를 차단한 시각 (후원자 -> 크리에이터 방향).
  /// 반대 방향(크리에이터 -> 후원자)은 사유·처리자까지 남기는 blocked_donor 테이블에 기록한다.
  /// 한 컬럼에 두 방향을 같이 쓰면 크리에이터가 차단을 해제할 때 후원자가 건 차단까지 풀린다.
  donorBlockedAt DateTime? @map("donor_blocked_at") @db.Timestamptz(3)
  dailyLimit     BigInt?   @map("daily_limit")
  totalAmount    BigInt    @default(0) @map("total_amount")
  totalCount     Int       @default(0) @map("total_count")
  lastDonatedAt  DateTime? @map("last_donated_at") @db.Timestamptz(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  donor   DonorProfile   @relation(fields: [donorId], references: [id], onDelete: Cascade)
  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@unique([donorId, creatorId])
  @@index([creatorId])
  @@map("donor_creator_link")
}

/// 크리에이터 -> 후원자 방향 차단. (반대 방향은 donor_creator_link.donor_blocked_at)
model BlockedDonor {
  id        String   @id
  creatorId String   @map("creator_id")
  donorId   String   @map("donor_id")
  reason    String?
  blockedBy String?  @map("blocked_by")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  donor   DonorProfile   @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([creatorId, donorId])
  @@map("blocked_donor")
}

// ===========================================================================
// 크리에이터
// ===========================================================================

model CreatorProfile {
  id                  String        @id
  userId              String        @unique @map("user_id")
  /// 현재 활성 코드 (이력은 creator_code 테이블)
  code                String        @unique
  displayName         String        @map("display_name")
  channelName         String?       @map("channel_name")
  /// 채널 플랫폼 (YOUTUBE|INSTAGRAM|FACEBOOK|TIKTOK|CHZZK|SOOP|TWITCH|OTHER)
  channelPlatform     String?       @map("channel_platform")
  avatarUrl           String?       @map("avatar_url")
  /// 후원 페이지 상단 배너 이미지 URL (크리에이터 꾸미기)
  bannerUrl           String?       @map("banner_url")
  description         String?
  /// 방송중 스위치: 켜면 후원 페이지에 온에어 표시 + 라이브 링크 노출
  liveOn              Boolean       @default(false) @map("live_on")
  /// 현재 노출 중인 라이브 방송 링크 (플랫폼별 주소에서 선택된 값)
  liveUrl             String?       @map("live_url")
  /// 라이브 플랫폼별 주소. livePlatform 이 가리키는 값이 후원샵에 노출된다.
  livePlatform        String?       @map("live_platform")
  youtubeLiveUrl      String?       @map("youtube_live_url")
  instagramLiveUrl    String?       @map("instagram_live_url")
  tiktokLiveUrl       String?       @map("tiktok_live_url")
  /// 대표 채널 주소. 신청 때 받은 값을 소개글에 이어 붙이면 소개 길이 제한을 넘겨
  /// 이후 후원샵 설정 저장이 영구히 막히므로 반드시 별도 컬럼에 보관한다.
  channelUrl          String?       @map("channel_url")
  status              CreatorStatus @default(PENDING)
  /// 문자 1건당 후원금 (원)
  donationAmount      BigInt        @default(3000) @map("donation_amount")
  minAmount           BigInt        @default(1000) @map("min_amount")
  maxAmount           BigInt        @default(50000) @map("max_amount")
  /// 크리에이터별 결제 모드 오버라이드 (null 이면 전역 설정)
  paymentMode         PaymentMode?  @map("payment_mode")
  /// 후원 감사 MT 문자 본문. null/빈 값이면 기본 템플릿을 사용한다.
  /// 치환자: {후원자} {크리에이터} {금액} {메시지} {누적}
  thanksMtMessage     String?       @map("thanks_mt_message")
  businessNo          String?       @map("business_no")
  /// 온보딩 체크리스트 중 자동 판별이 불가능해 크리에이터가 직접 체크하는 항목.
  /// OBS/프리즘 등 방송 프로그램에 오버레이 URL 을 등록했는지 여부.
  onboardingObsLinked Boolean       @default(false) @map("onboarding_obs_linked")
  /// 테스트 후원 미리보기로 실제 화면에 표시되는 것까지 확인했는지 여부.
  onboardingTestDone  Boolean       @default(false) @map("onboarding_test_done")
  approvedAt          DateTime?     @map("approved_at") @db.Timestamptz(3)
  suspendedAt         DateTime?     @map("suspended_at") @db.Timestamptz(3)
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  // 하드 삭제로 정산계좌·오버레이 설정·유튜브 연동까지 함께 사라지면 안 된다.
  // 탈퇴는 status=WITHDRAWN 소프트 삭제로 처리하므로 삭제 자체를 막는다.
  user               User                  @relation(fields: [userId], references: [id], onDelete: Restrict)
  codes              CreatorCode[]
  moRoutes           CreatorMoNumber[]
  donations          Donation[]
  donorLinks         DonorCreatorLink[]
  blockedDonors      BlockedDonor[]
  overlaySetting     OverlaySetting?
  overlayTiers       OverlayTier[]
  ttsSetting         TtsSetting?
  youtubeConnection  YouTubeConnection?
  youtubeBroadcasts  YouTubeBroadcast[]
  settlementAccount  SettlementAccount?
  ledgerEntries      SettlementLedger[]
  settlementRequests SettlementRequest[]
  feePolicies        FeePolicy[]
  limitPolicies      DonationLimitPolicy[]
  bannedWords        BannedWord[]
  moMessages         MoInboundMessage[]
  games              Game[]

  @@index([status])
  @@map("creator_profile")
}

model CreatorCode {
  id        String    @id
  creatorId String    @map("creator_id")
  code      String    @unique
  active    Boolean   @default(true)
  issuedAt  DateTime  @default(now()) @map("issued_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@index([creatorId])
  @@map("creator_code")
}

/// MO 수신 경로. DEDICATED = 전용번호, SHARED_PREFIX = 대표번호 + 키워드
model CreatorMoNumber {
  id          String         @id
  phoneNumber String         @map("phone_number")
  /// SHARED_PREFIX 모드에서 문자 맨 앞 키워드 (대문자 정규화 저장)
  keyword     String?
  mode        MoRouteMode    @default(DEDICATED)
  status      MoNumberStatus @default(AVAILABLE)
  providerId  String?        @map("provider_id")
  creatorId   String?        @map("creator_id")
  monthlyCost BigInt         @default(0) @map("monthly_cost")
  assignedAt  DateTime?      @map("assigned_at") @db.Timestamptz(3)
  releasedAt  DateTime?      @map("released_at") @db.Timestamptz(3)
  memo        String?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator CreatorProfile? @relation(fields: [creatorId], references: [id])

  @@unique([phoneNumber, keyword])
  @@index([status])
  @@index([creatorId])
  @@map("creator_mo_number")
}

// ===========================================================================
// 문자 (MO 수신 / MT 발송)
// 운영환경에서는 created_at 기준 월 단위 파티셔닝 적용 (별도 SQL 마이그레이션)
// ===========================================================================

model MoInboundMessage {
  id                String          @id
  /// MO 사업자 메시지 ID. 중복 수신 차단의 1차 방어선
  providerMessageId String          @unique @map("provider_message_id")
  providerCode      String          @map("provider_code")
  receivedNumber    String          @map("received_number")
  phoneHash         String          @map("phone_hash")
  phoneEnc          String          @map("phone_enc")
  phoneMasked       String          @map("phone_masked")
  messageType       MessageType     @default(SMS) @map("message_type")
  /// 원문은 개인정보가 포함될 수 있어 암호화 저장
  contentEnc        String          @map("content_enc")
  /// 필터링 후 방송 노출용 텍스트
  contentFiltered   String?         @map("content_filtered")
  attachmentInfo    Json?           @map("attachment_info")
  creatorId         String?         @map("creator_id")
  matchedKeyword    String?         @map("matched_keyword")
  result            MoProcessResult @default(PENDING)
  resultDetail      String?         @map("result_detail")
  receivedAt        DateTime        @map("received_at") @db.Timestamptz(3)
  processedAt       DateTime?       @map("processed_at") @db.Timestamptz(3)
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  creator  CreatorProfile? @relation(fields: [creatorId], references: [id])
  donation Donation?

  @@index([creatorId, receivedAt])
  @@index([phoneHash, receivedAt])
  @@index([result])
  // 관리자 수신 문자 목록은 필터 없이 최신순으로 연다.
  // 시간축 단독 인덱스가 없으면 표가 커질수록 매번 전체를 정렬한다.
  @@index([receivedAt])
  @@map("mo_inbound_message")
}

model MtOutboundMessage {
  id                String         @id
  phoneHash         String         @map("phone_hash")
  phoneEnc          String         @map("phone_enc")
  phoneMasked       String         @map("phone_masked")
  fromNumber        String         @map("from_number")
  messageType       MessageType    @default(SMS) @map("message_type")
  templateCode      String?        @map("template_code")
  /// 발송 본문. 보안링크 토큰 원문은 포함하지 않고 마스킹 저장
  bodyMasked        String         @map("body_masked")
  status            DeliveryStatus @default(PENDING)
  providerCode      String?        @map("provider_code")
  providerMessageId String?        @map("provider_message_id")
  resultCode        String?        @map("result_code")
  resultMessage     String?        @map("result_message")
  donationId        String?        @map("donation_id")
  creatorId         String?        @map("creator_id")
  attempts          Int            @default(0)
  sentAt            DateTime?      @map("sent_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  donation Donation? @relation(fields: [donationId], references: [id])

  @@index([phoneHash, createdAt])
  @@index([status])
  @@index([donationId])
  // 20260819100100_guards_and_indexes 에서 raw SQL 로 만든 인덱스. 드리프트 방지용 선언.
  @@index([creatorId, createdAt])
  // MT 발송 관리 목록도 기본 진입이 필터 없는 최신순이다.
  @@index([createdAt])
  @@map("mt_outbound_message")
}

/// MT 로 전송되는 1회용 보안 링크
model SecureLink {
  id         String            @id
  tokenHash  String            @unique @map("token_hash")
  purpose    SecureLinkPurpose
  phoneHash  String            @map("phone_hash")
  creatorId  String?           @map("creator_id")
  donationId String?           @unique @map("donation_id")
  payload    Json?
  expiresAt  DateTime          @map("expires_at") @db.Timestamptz(3)
  usedAt     DateTime?         @map("used_at") @db.Timestamptz(3)
  usedIp     String?           @map("used_ip")
  usedAgent  String?           @map("used_agent")
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  donation Donation? @relation(fields: [donationId], references: [id])

  @@index([phoneHash])
  @@index([expiresAt])
  @@map("secure_link")
}

// ===========================================================================
// 결제
// ===========================================================================

/// 결제수단 종류. 현재는 계좌(내통장결제)만 운영하고 카드 빌링키는 구조만 준비되어 있다.
enum PaymentMethodKind {
  ACCOUNT
  CARD

  @@map("payment_method_kind")
}

model PaymentRegistration {
  id            String             @id
  donorId       String             @map("donor_id")
  creatorId     String?            @map("creator_id")
  provider      String             @default("HECTO")
  /// 등록하려는 결제수단 종류
  method        PaymentMethodKind  @default(ACCOUNT)
  providerTid   String?            @map("provider_tid")
  status        RegistrationStatus @default(STARTED)
  resultCode    String?            @map("result_code")
  resultMessage String?            @map("result_message")
  /// 민감값 제거된 응답 스냅샷
  rawMasked     Json?              @map("raw_masked")
  startedAt     DateTime           @default(now()) @map("started_at") @db.Timestamptz(3)
  completedAt   DateTime?          @map("completed_at") @db.Timestamptz(3)

  donor DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([donorId])
  @@index([status])
  @@map("payment_registration")
}

model PaymentMethodToken {
  id           String             @id
  donorId      String             @map("donor_id")
  provider     String             @default("HECTO")
  /// 빌키 종류. ACCOUNT = 내통장결제 계좌 빌키, CARD = 카드 빌링키(추후 연동)
  method       PaymentMethodKind  @default(ACCOUNT)
  /// 빌키 암호문. 복호화는 결제 워커에서만 수행하며 로그 출력 금지
  billKeyEnc   String             @map("bill_key_enc")
  billKeyHint  String             @map("bill_key_hint")
  bankCode     String?            @map("bank_code")
  bankName     String?            @map("bank_name")
  /// 계좌 원문 저장 금지. 끝 4자리만 보관
  accountTail4 String?            @map("account_tail4")
  /// 카드 빌링키용. 카드 원문 저장 금지, 발급사명과 끝 4자리만 보관
  cardIssuer   String?            @map("card_issuer")
  cardTail4    String?            @map("card_tail4")
  status       PaymentTokenStatus @default(ACTIVE)
  registeredAt DateTime           @default(now()) @map("registered_at") @db.Timestamptz(3)
  revokedAt    DateTime?          @map("revoked_at") @db.Timestamptz(3)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  donor DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@index([donorId, status])
  @@map("payment_method_token")
}

model Donation {
  id            String         @id
  /// 대외 노출용 거래번호
  transactionNo String         @unique @map("transaction_no")
  creatorId     String         @map("creator_id")
  donorId       String?        @map("donor_id")
  moMessageId   String?        @unique @map("mo_message_id")
  amount        BigInt
  displayName   String         @map("display_name")
  /// 필터링 완료된 방송 노출용 메시지
  message       String
  /// 원문 암호화 보관 (분쟁 대응)
  messageRawEnc String?        @map("message_raw_enc")
  status        DonationStatus @default(RECEIVED)
  statusReason  String?        @map("status_reason")
  /// 접수 채널: MO(문자) | WEB(후원샵 PC 웹 후원)
  channel       String         @default("MO")
  paymentMode   PaymentMode    @default(CONFIRM_LINK) @map("payment_mode")
  isTest        Boolean        @default(false) @map("is_test")
  anonymous     Boolean        @default(false)

  /// 결제수수료 차감액 (부가세 포함)
  pgFee       BigInt @default(0) @map("pg_fee")
  /// 플랫폼수수료 차감액 (부가세 포함)
  platformFee BigInt @default(0) @map("platform_fee")
  /// 위 두 수수료에 포함된 부가세 합계 (표시용. 이미 pgFee/platformFee 에 포함되어 있다)
  feeVat      BigInt @default(0) @map("fee_vat")
  netAmount   BigInt @default(0) @map("net_amount")

  mtStatus      DeliveryStatus @default(PENDING) @map("mt_status")
  youtubeStatus DeliveryStatus @default(PENDING) @map("youtube_status")
  overlayStatus DeliveryStatus @default(PENDING) @map("overlay_status")

  receivedAt    DateTime  @default(now()) @map("received_at") @db.Timestamptz(3)
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(3)
  broadcastedAt DateTime? @map("broadcasted_at") @db.Timestamptz(3)
  refundedAt    DateTime? @map("refunded_at") @db.Timestamptz(3)
  settledAt     DateTime? @map("settled_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator        CreatorProfile        @relation(fields: [creatorId], references: [id])
  donor          DonorProfile?         @relation(fields: [donorId], references: [id])
  moMessage      MoInboundMessage?     @relation(fields: [moMessageId], references: [id])
  transactions   PaymentTransaction[]
  refunds        Refund[]
  mtMessages     MtOutboundMessage[]
  chatDeliveries YouTubeChatDelivery[]
  overlayEvents  OverlayEvent[]
  ledgerEntries  SettlementLedger[]
  secureLink     SecureLink?
  pinSession     PaymentPinSession?
  statusLogs     DonationStatusLog[]

  @@index([creatorId, receivedAt])
  @@index([donorId, receivedAt])
  @@index([status])
  @@index([receivedAt])
  // 아래 2개는 20260819100100_guards_and_indexes 에서 raw SQL 로 만든 인덱스다.
  // 스키마에 선언해 두지 않으면 다음 migrate 때 DROP 하는 마이그레이션이 자동 생성된다.
  @@index([creatorId, status])
  @@index([paidAt])
  @@map("donation")
}

model DonationStatusLog {
  id         String          @id
  donationId String          @map("donation_id")
  fromStatus DonationStatus? @map("from_status")
  toStatus   DonationStatus  @map("to_status")
  reason     String?
  actor      String?
  createdAt  DateTime        @default(now()) @map("created_at") @db.Timestamptz(3)

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@map("donation_status_log")
}

model PaymentTransaction {
  id            String          @id
  donationId    String          @map("donation_id")
  /// 가맹점 주문번호. PG 멱등키로 재사용
  orderNo       String          @unique @map("order_no")
  provider      String          @default("HECTO")
  providerTid   String?         @map("provider_tid")
  amount        BigInt
  status        PaymentTxStatus @default(REQUESTED)
  resultCode    String?         @map("result_code")
  resultMessage String?         @map("result_message")
  rawMasked     Json?           @map("raw_masked")
  requestedAt   DateTime        @default(now()) @map("requested_at") @db.Timestamptz(3)
  approvedAt    DateTime?       @map("approved_at") @db.Timestamptz(3)
  canceledAt    DateTime?       @map("canceled_at") @db.Timestamptz(3)
  updatedAt     DateTime        @updatedAt @map("updated_at") @db.Timestamptz(3)

  donation Donation         @relation(fields: [donationId], references: [id], onDelete: Cascade)
  attempts PaymentAttempt[]

  @@index([donationId])
  @@index([status])
  @@index([providerTid])
  // 결제 관리 목록 기본 정렬.
  @@index([requestedAt])
  @@map("payment_transaction")
}

model PaymentAttempt {
  id             String   @id
  transactionId  String   @map("transaction_id")
  attemptNo      Int      @map("attempt_no")
  operation      String
  requestMasked  Json?    @map("request_masked")
  responseMasked Json?    @map("response_masked")
  latencyMs      Int?     @map("latency_ms")
  errorCode      String?  @map("error_code")
  errorMessage   String?  @map("error_message")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  transaction PaymentTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  @@index([transactionId])
  @@map("payment_attempt")
}

/// 결제사 PIN 인증 세션 상태
enum PinSessionStatus {
  PENDING
  COMPLETED
  EXPIRED
  FAILED

  @@map("pin_session_status")
}

/// 결제사(헥토 내통장결제 / 카드 빌링키)의 PIN 인증 세션.
///
/// MO 수신 후 빌키가 있는 후원자에게는 토네이도 자체 확인 링크 대신
/// 결제사가 발급한 PIN 입력 링크를 MT 로 보낸다. 후원자가 PIN 을 넣으면
/// 결제사가 콜백을 보내고, 그때 승인(executePayment)이 실행된다.
///
/// 후원 1건당 세션 1건(donationId UNIQUE)이며, 이 유니크 제약이
/// 콜백 중복 수신에 대한 마지막 방어선이 된다.
model PaymentPinSession {
  id             String            @id
  donationId     String            @unique @map("donation_id")
  provider       String
  /// 인증 대상 결제수단 종류 (계좌 빌키 / 카드 빌링키)
  method         PaymentMethodKind @default(ACCOUNT)
  /// 결제사가 발급한 인증 세션 식별자
  sessionId      String            @unique @map("session_id")
  /// PIN 입력 URL. 토큰이 포함되므로 마스킹해 저장한다(원문 저장 금지)
  pinUrlMasked   String            @map("pin_url_masked")
  amount         BigInt
  status         PinSessionStatus  @default(PENDING)
  /// 실제 결제사 연동이 아니라 mock 발급인지 여부. 화면/로그에 [MOCK] 로 표시한다.
  mock           Boolean           @default(false)
  callbackCount  Int               @default(0) @map("callback_count")
  resultNote     String?           @map("result_note")
  expiresAt      DateTime          @map("expires_at") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  lastCallbackAt DateTime?         @map("last_callback_at") @db.Timestamptz(3)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([status, expiresAt])
  @@map("payment_pin_session")
}

model Refund {
  id            String       @id
  donationId    String       @map("donation_id")
  amount        BigInt
  reason        String?
  status        RefundStatus @default(REQUESTED)
  requestedBy   String?      @map("requested_by")
  approvedBy    String?      @map("approved_by")
  providerTid   String?      @map("provider_tid")
  resultCode    String?      @map("result_code")
  resultMessage String?      @map("result_message")
  requestedAt   DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  processedAt   DateTime?    @map("processed_at") @db.Timestamptz(3)

  donation Donation @relation(fields: [donationId], references: [id], onDelete: Cascade)

  @@index([donationId])
  @@index([status])
  @@map("refund")
}

/// 결제/거래 생성 멱등성 보장
model IdempotencyKey {
  id         String   @id
  scope      String
  key        String
  resourceId String?  @map("resource_id")
  status     String   @default("IN_PROGRESS")
  resultHash String?  @map("result_hash")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  expiresAt  DateTime @map("expires_at") @db.Timestamptz(3)

  @@unique([scope, key])
  @@index([expiresAt])
  @@map("idempotency_key")
}

// ===========================================================================
// 한도 / 리스크 / 콘텐츠
// ===========================================================================

model DonationLimitPolicy {
  id                    String      @id
  scope                 PolicyScope @default(GLOBAL)
  creatorId             String?     @map("creator_id")
  donorId               String?     @map("donor_id")
  defaultAmount         BigInt      @default(3000) @map("default_amount")
  minAmount             BigInt      @default(1000) @map("min_amount")
  maxAmount             BigInt      @default(50000) @map("max_amount")
  donorDailyLimit       BigInt      @default(100000) @map("donor_daily_limit")
  donorMonthlyLimit     BigInt      @default(1000000) @map("donor_monthly_limit")
  perCreatorDailyLimit  BigInt      @default(50000) @map("per_creator_daily_limit")
  /// 1인(후원자) 1일 최대 후원 건수. 금액 한도와 별개로 건수 자체를 제한한다.
  donorDailyMaxCount    Int         @default(30) @map("donor_daily_max_count")
  velocityWindowSec     Int         @default(60) @map("velocity_window_sec")
  velocityMaxCount      Int         @default(3) @map("velocity_max_count")
  cooldownAfterCount    Int         @default(5) @map("cooldown_after_count")
  cooldownSec           Int         @default(300) @map("cooldown_sec")
  failureLockThreshold  Int         @default(3) @map("failure_lock_threshold")
  newDonorFirstDayLimit BigInt      @default(30000) @map("new_donor_first_day_limit")
  manualReviewAmount    BigInt      @default(200000) @map("manual_review_amount")
  ttsMinAmount          BigInt      @default(3000) @map("tts_min_amount")
  active                Boolean     @default(true)
  effectiveFrom         DateTime    @default(now()) @map("effective_from") @db.Timestamptz(3)
  effectiveTo           DateTime?   @map("effective_to") @db.Timestamptz(3)
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt             DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator CreatorProfile? @relation(fields: [creatorId], references: [id])

  @@index([scope, active])
  @@map("donation_limit_policy")
}

/// 기간별 후원 집계 (Redis 캐시의 영속 원본)
model DonationCounter {
  id         String   @id
  donorId    String   @map("donor_id")
  /// 전체 합계 행은 'ALL' 센티널 사용.
  /// (PostgreSQL 은 NULL 을 서로 다른 값으로 취급하므로 UNIQUE 제약이 무력화된다)
  creatorId  String   @default("ALL") @map("creator_id")
  periodType String   @map("period_type")
  periodKey  String   @map("period_key")
  count      Int      @default(0)
  amount     BigInt   @default(0)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  donor DonorProfile @relation(fields: [donorId], references: [id], onDelete: Cascade)

  @@unique([donorId, creatorId, periodType, periodKey])
  @@index([periodKey])
  @@map("donation_counter")
}

model RiskDetection {
  id         String    @id
  donorId    String?   @map("donor_id")
  creatorId  String?   @map("creator_id")
  donationId String?   @map("donation_id")
  type       RiskType
  level      RiskLevel @default(LOW)
  detail     Json?
  resolved   Boolean   @default(false)
  resolvedBy String?   @map("resolved_by")
  resolvedAt DateTime? @map("resolved_at") @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  donor DonorProfile? @relation(fields: [donorId], references: [id])

  @@index([level, resolved])
  @@index([createdAt])
  @@map("risk_detection")
}

model BannedWord {
  id        String        @id
  word      String
  action    ContentAction @default(MASK)
  scope     PolicyScope   @default(GLOBAL)
  creatorId String?       @map("creator_id")
  active    Boolean       @default(true)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  creator CreatorProfile? @relation(fields: [creatorId], references: [id])

  // 유니크는 부분 인덱스(banned_word_global_uniq / banned_word_creator_uniq)로 DB 레벨에서 강제한다
  @@index([word])
  @@index([scope, active])
  @@map("banned_word")
}

// ===========================================================================
// 유튜브 / 방송 / 오버레이
// ===========================================================================

model YouTubeConnection {
