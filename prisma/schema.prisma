  creatorId       String                  @unique @map("creator_id")
  channelId       String                  @map("channel_id")
  channelTitle    String?                 @map("channel_title")
  channelThumb    String?                 @map("channel_thumb")
  accessTokenEnc  String                  @map("access_token_enc")
  refreshTokenEnc String                  @map("refresh_token_enc")
  scope           String
  expiresAt       DateTime                @map("expires_at") @db.Timestamptz(3)
  status          YouTubeConnectionStatus @default(CONNECTED)
  lastError       String?                 @map("last_error")
  lastCheckedAt   DateTime?               @map("last_checked_at") @db.Timestamptz(3)
  createdAt       DateTime                @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime                @updatedAt @map("updated_at") @db.Timestamptz(3)

  creator CreatorProfile @relation(fields: [creatorId], references: [id], onDelete: Cascade)

  @@map("youtube_connection")
}

model YouTubeBroadcast {
  id          String    @id
  creatorId   String    @map("creator_id")
  broadcastId String    @map("broadcast_id")
  liveChatId  String?   @map("live_chat_id")
  title       String?
  lifeCycle   String?   @map("life_cycle")
  chatEnabled Boolean   @default(true) @map("chat_enabled")
  startedAt   DateTime? @map("started_at") @db.Timestamptz(3)
  endedAt     DateTime? @map("ended_at") @db.Timestamptz(3)
  detectedAt  DateTime  @default(now()) @map("detected_at") @db.Timestamptz(3)

  creator    CreatorProfile        @relation(fields: [creatorId], references: [id], onDelete: Cascade)
  deliveries YouTubeChatDelivery[]

  @@unique([creatorId, broadcastId])
  @@index([creatorId, detectedAt])
