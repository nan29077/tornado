  @@index([status])
  @@map("overlay_event")
}

model TtsSetting {
  id                   String   @id
  creatorId            String   @unique @map("creator_id")
  enabled              Boolean  @default(true)
  voice                String   @default("ko-KR-Standard-A")
  speed                Float    @default(1.0)
  volume               Float    @default(1.0)
  readAmount           Boolean  @default(true) @map("read_amount")
  readName             Boolean  @default(true) @map("read_name")
  minAmount            BigInt   @default(3000) @map("min_amount")
  maxChars             Int      @default(80) @map("max_chars")
  /// 음성 합성 제공사. browser = 오버레이 브라우저의 Web Speech API, naver = 네이버 클로바 Voice 서버 합성
  provider             String   @default("browser") @map("tts_provider")
  /// 네이버 클로바 Voice 인증 정보. 암호화해서 저장하고 화면에는 마스킹만 노출한다.
  naverClientIdEnc     String?  @map("naver_client_id_enc")
  naverClientSecretEnc String?  @map("naver_client_secret_enc")
  /// 화면 표시용 마스킹 값 (원문 복원 불가)
  naverClientIdMasked  String?  @map("naver_client_id_masked")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
